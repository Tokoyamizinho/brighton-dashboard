	/// Resultados dos últimos 5 jogos em ordem cronológica (V/E/D).
	measure 'Forma (Últimos 5)' =
			VAR _ult5 =
			    TOPN (
			        5,
			        CALCULATETABLE ( fact_team_match, fact_team_match[is_brighton] = TRUE () ),
			        fact_team_match[datetime], DESC
			    )
			RETURN
			    CONCATENATEX ( _ult5, fact_team_match[result_pt], "  ", fact_team_match[datetime], ASC )
		displayFolder: 1. Resultados
		lineageTag: cbc863cf-0fb0-532b-8168-06c61b9fb47a

	measure 'Pontos nos Últimos 5' =
			VAR _ult5 =
			    TOPN (

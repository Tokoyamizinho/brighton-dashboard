	/// Pontos a mais do que o placar do intervalo daria (viradas e empates arrancados).
	measure 'Pontos Ganhos após o Intervalo' =
			CALCULATE (
			    SUM ( fact_team_match[points_vs_halftime] ),
			    fact_team_match[is_brighton] = TRUE (),
			    fact_team_match[points_vs_halftime] > 0
			)
		formatString: 0
		displayFolder: 2. Primeiro e Segundo Tempo
		lineageTag: 464a2557-42f5-5632-ae20-95ee0c9569c7

	/// Pontos que o placar do intervalo daria e escaparam no 2º tempo.
	measure 'Pontos Perdidos após o Intervalo' =
			- CALCULATE (
			    SUM ( fact_team_match[points_vs_halftime] ),
			    fact_team_match[is_brighton] = TRUE (),
			    fact_team_match[points_vs_halftime] < 0
			)
		formatString: 0
		displayFolder: 2. Primeiro e Segundo Tempo
		lineageTag: 4b20d682-a22c-5de0-aac4-b996d9afcb7a

	measure 'Saldo de Pontos no 2º Tempo' = [Pontos Ganhos após o Intervalo] - [Pontos Perdidos após o Intervalo]

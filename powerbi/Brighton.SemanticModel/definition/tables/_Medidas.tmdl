			        CALCULATETABLE ( fact_team_match, fact_team_match[is_brighton] = TRUE () ),
			        fact_team_match[datetime], DESC
			    )
			RETURN
			    SUMX ( _ult5, fact_team_match[pts] )
		formatString: 0

		displayFolder: 5. Jogadores
		lineageTag: 063bb5c1-98c6-5a35-bbf1-6bc516516e61

	/// Gols + assistências do jogador sobre os gols do time na Premier League.
	measure 'Participação nos Gols %' = DIVIDE ( [G+A], [Gols Pró] )
		formatString: 0%
		displayFolder: 5. Jogadores
		lineageTag: 080c365d-1fd8-5ef6-a053-2271e5da6443

	measure 'Jogadores Utilizados' = CALCULATE ( DISTINCTCOUNT ( fact_player_season[player_key] ), fact_player_season[pl_apps] > 0 )
		formatString: 0
		displayFolder: 5. Jogadores
		lineageTag: b42217ac-c878-5bf1-aa68-06649c6794dc

	measure Artilheiro =
			VAR _t =
			    TOPN (
			        1,
			        ADDCOLUMNS ( VALUES ( dim_player[player_name] ), "@g", [Gols (Jogador)] ),
			        [@g], DESC
			    )
			RETURN
			    MAXX ( _t, dim_player[player_name] & " (" & [@g] & ")" )
		displayFolder: 5. Jogadores
		lineageTag: 54a3a55a-9f2f-5c70-8995-b079d81975b4

	measure 'Líder em Assistências' =
			VAR _t =
			    TOPN (
			        1,
			        ADDCOLUMNS ( VALUES ( dim_player[player_name] ), "@a", [Assistências] ),
			        [@a], DESC
			    )
			RETURN
			    MAXX ( _t, dim_player[player_name] & " (" & [@a] & ")" )
		displayFolder: 5. Jogadores
		lineageTag: dd49aff1-8c75-5c69-9774-3ce313b4b685

	/// Soma das taxas pagas em libras (valores não divulgados ficam de fora).
	measure Gasto = CALCULATE ( SUM ( fact_transfers[fee_gbp] ), fact_transfers[direction] = "Chegada" )
		formatString: "£"#,0;-"£"#,0;"£"0
		displayFolder: 6. Transferências
		lineageTag: 70aae2d3-efd8-5c8d-ad38-bdad2449e535

	measure Receita = CALCULATE ( SUM ( fact_transfers[fee_gbp] ), fact_transfers[direction] = "Saída" )
		formatString: "£"#,0;-"£"#,0;"£"0
		displayFolder: 6. Transferências
		lineageTag: d8c91074-60e4-5450-89ec-e531a5905ab9

	/// Receita - Gasto. Positivo = o clube vendeu mais do que comprou.
	measure 'Saldo de Transferências' = [Receita] - [Gasto]
		formatString: "£"#,0;-"£"#,0;"£"0
		displayFolder: 6. Transferências
		lineageTag: 1d18b242-e530-5f7f-890f-3e065cb4f14e

	measure Chegadas = CALCULATE ( COUNTROWS ( fact_transfers ), fact_transfers[direction] = "Chegada" )
		formatString: 0
		displayFolder: 6. Transferências
		lineageTag: 25f32004-1cba-51df-871e-8d0ffe4773a9

	measure Saídas = CALCULATE ( COUNTROWS ( fact_transfers ), fact_transfers[direction] = "Saída" )
		formatString: 0
		displayFolder: 6. Transferências
		lineageTag: a0980e95-559d-5b99-a9d6-6d7b599ad1e2

	measure 'Contratações Pagas' =
			CALCULATE (
			    COUNTROWS ( fact_transfers ),
			    fact_transfers[direction] = "Chegada",
			    fact_transfers[fee_type] = "Pago"
			)
		formatString: 0
		displayFolder: 6. Transferências
		lineageTag: 3fcb5147-9a74-52e7-9ae4-d784ccc5b855

	/// Negócios sem valor público; não entram no Gasto nem na Receita.
	measure 'Valores Não Divulgados' = CALCULATE ( COUNTROWS ( fact_transfers ), fact_transfers[fee_type] = "Não divulgado" )
		formatString: 0
		displayFolder: 6. Transferências
		lineageTag: 9c2ec3c9-7229-5141-a531-61ca58555be6

	measure 'Empréstimos Cedidos' =
			CALCULATE (
			    COUNTROWS ( fact_transfers ),
			    fact_transfers[direction] = "Saída",
			    fact_transfers[movement] = "Empréstimo"
			)
		formatString: 0
		displayFolder: 6. Transferências
		lineageTag: a64a0afe-2bf0-5b07-94a2-dd30526a3210

	measure 'Gasto Médio por Contratação' = DIVIDE ( [Gasto], [Contratações Pagas] )
		formatString: "£"#,0;-"£"#,0;"£"0
		displayFolder: 6. Transferências
		lineageTag: 3afdb5cf-8c72-5213-8fb9-0d1cd0e30190

	measure 'Maior Contratação' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( fact_transfers, fact_transfers[direction] = "Chegada" && fact_transfers[fee_gbp] > 0 ),
			        fact_transfers[fee_gbp], DESC
			    )
			RETURN
			    MAXX ( _t, fact_transfers[player_name] & " • £" & FORMAT ( fact_transfers[fee_gbp] / 1000000, "0.0" ) & "M" )
		displayFolder: 6. Transferências
		lineageTag: 34de11a8-c438-5d54-99ae-7602ac874fd9

	measure 'Maior Venda' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( fact_transfers, fact_transfers[direction] = "Saída" && fact_transfers[fee_gbp] > 0 ),
			        fact_transfers[fee_gbp], DESC
			    )
			RETURN
			    MAXX ( _t, fact_transfers[player_name] & " • £" & FORMAT ( fact_transfers[fee_gbp] / 1000000, "0.0" ) & "M" )
		displayFolder: 6. Transferências
		lineageTag: 38f8dec3-a318-5a52-b367-4d6cd1139dc6

	measure 'Título da Página' = "Brighton & Hove Albion  •  " & SELECTEDVALUE ( dim_season[season_label], "Várias temporadas" )
		displayFolder: 7. Textos e Cores
		lineageTag: 4c828f1b-e4cb-53ba-8e08-857a3f75c38d

	measure 'Subtítulo da Rodada' = "Premier League  •  após " & [Rodada Atual] & " rodadas  •  dados até " & FORMAT ( [Dados Até], "dd/mm/yyyy" )
		displayFolder: 7. Textos e Cores
		lineageTag: f37dfe35-feba-5ec7-900d-835dc4b5c714

	measure 'Última Atualização' = "Atualizado em " & CALCULATE ( MAX ( meta_refresh[last_refresh_utc] ), meta_refresh[source] = "pipeline" ) & " (UTC)"
		displayFolder: 7. Textos e Cores
		lineageTag: 252011dd-2e12-5361-9720-a31c3e849269

	/// Texto de atribuição exigido pela licença CC BY-SA da Wikipedia. Deixe visível no rodapé.
	measure 'Fonte dos Dados' = "Dados: Wikipedia (CC BY-SA 4.0) e openfootball (domínio público). Projeto sem afiliação com o clube ou a Premier League."
		displayFolder: 7. Textos e Cores
		lineageTag: 9dcfec6f-d20a-5ac3-9bdd-ff9f821a5050

	/// Formatação condicional (Valor do campo) para resultados V/E/D.
	measure 'Cor do Resultado' =
			SWITCH (
			    SELECTEDVALUE ( fact_team_match[result_pt] ),
			    "V", "#2DA866",
			    "E", "#D99A00",
			    "D", "#D64545",
			    "#8A9AB0"
			)
		displayFolder: 7. Textos e Cores
		lineageTag: 5db4cd5d-c95d-5858-a824-6d084bd0494b

	measure 'Cor da Dificuldade' =
			SWITCH (
			    SELECTEDVALUE ( fact_fixtures[difficulty] ),
			    1, "#1E8E5A",
			    2, "#2DA866",
			    3, "#8A9AB0",
			    4, "#E8743B",
			    5, "#E53935",
			    "#8A9AB0"
			)
		displayFolder: 7. Textos e Cores
		lineageTag: e39a3ffb-6a7f-59cd-affc-cc4509b06e42

	measure 'Cor do Saldo de Gols' = IF ( [Saldo de Gols] >= 0, "#2DA866", "#D64545" )
		displayFolder: 7. Textos e Cores
		lineageTag: 94bf6cd2-3d29-5abc-8c0e-69ac16a85e6a

	/// Na temporada atual mostra a posição parcial.
	measure 'Posição Final' =
			VAR _s = MAX ( dim_season[season] )
			RETURN
			    IF (
			        SELECTEDVALUE ( dim_season[is_current], FALSE () ),
			        CALCULATE ( [Posição Atual], dim_season[season] = _s ),
			        MAX ( dim_season[brighton_final_position] )
			    )
		formatString: 0"º"
		displayFolder: 8. Histórico
		lineageTag: 546796be-a9d4-5fb1-aaa7-d8746ae64031

	measure 'Jogos (Tabela)' = CALCULATE ( MAX ( fact_standings[round] ), fact_standings[is_latest] = TRUE () )
		formatString: 0
		displayFolder: 4. Tabela e Momento
		lineageTag: 967059c2-0e08-4043-b805-e6ba42dbf872

	partition _Medidas = m
		mode: import
		source =
				let
				  Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Colunas Removidas" = Table.RemoveColumns(Origem,{"Coluna 1"})
				in
				  #"Colunas Removidas"

	annotation PBI_ResultType = Table


	measure 'Pontos na Mesma Rodada (Temporada Anterior)' =
			VAR _s = MAX ( dim_season[season] )
			VAR _r =
			    IF (
			        ISFILTERED ( fact_standings[round] ),
			        MAX ( fact_standings[round] ),
			        [Rodada Atual]
			    )
			RETURN
			    CALCULATE (
			        MAX ( fact_standings[pts_cum] ),
			        REMOVEFILTERS ( dim_season ),
			        dim_team[is_brighton] = TRUE (),
			        fact_standings[season] = _s - 1,
			        fact_standings[round] = _r
			    )
		formatString: 0
		displayFolder: 4. Tabela e Momento
		lineageTag: 9e970dbc-1111-5370-b2f2-f69baa314406

	measure 'Pontos vs Temporada Anterior' = [Pontos] - [Pontos na Mesma Rodada (Temporada Anterior)]
		formatString: +0;-0;0
		displayFolder: 4. Tabela e Momento
		lineageTag: 08e06a48-02a9-582e-b033-e974ed63ae16

	/// Negativo = pontos que faltam para alcançar o 4º colocado na mesma rodada.
	measure 'Distância para o 4º' =
			VAR _r = [Rodada Atual]
			VAR _tab =
			    CALCULATETABLE ( fact_standings, fact_standings[round] = _r, REMOVEFILTERS ( dim_team ) )
			VAR _quarto = MINX ( TOPN ( 4, _tab, fact_standings[pts_cum], DESC ), fact_standings[pts_cum] )
			RETURN
			    [Pontos Acumulados] - _quarto
		formatString: +0;-0;0
		displayFolder: 4. Tabela e Momento
		lineageTag: 18e28ec2-60e8-5afc-a84e-c9660d027f08

	/// Pontos de vantagem sobre o 18º colocado na mesma rodada.
	measure 'Distância para o Rebaixamento' =
			VAR _r = [Rodada Atual]
			VAR _tab =
			    CALCULATETABLE ( fact_standings, fact_standings[round] = _r, REMOVEFILTERS ( dim_team ) )
			VAR _z = MAXX ( TOPN ( 3, _tab, fact_standings[pts_cum], ASC ), fact_standings[pts_cum] )
			RETURN
			    [Pontos Acumulados] - _z
		formatString: +0;-0;0
		displayFolder: 4. Tabela e Momento
		lineageTag: 320e2a59-9722-547a-a529-43d6b70948dd

	/// Primeiro jogo que ainda não terminou (início + 2h), comparado com a hora do computador (NOW). Muda sozinho depois de cada jogo, sem precisar rodar o Python de novo.
	measure 'Próximo Jogo (Brasília)' =
			VAR _agora = NOW () - 2 / 24
			RETURN
			    CALCULATE (
			        MIN ( fact_fixtures[kickoff_brasilia] ),
			        fact_fixtures[kickoff_brasilia] > _agora
			    )
		formatString: dd/mm "às" hh:nn
		displayFolder: 4. Tabela e Momento
		lineageTag: 7ad724d6-cb9d-5def-bb12-cd310041398b

	measure 'Próximo Adversário' =
			VAR _k = [Próximo Jogo (Brasília)]
			RETURN
			    CALCULATE (
			        MAXX ( fact_fixtures, fact_fixtures[opponent] & " (" & fact_fixtures[venue] & ")" ),
			        fact_fixtures[kickoff_brasilia] = _k
			    )
		displayFolder: 4. Tabela e Momento
		lineageTag: 826a2c44-5062-5a2e-91dd-e3dbc5946f6b

	/// 1 para o próximo jogo, 2 para o seguinte... (vazio para jogos já disputados). Use como filtro do visual (entre 1 e 5) na tabela de próximos jogos.
	measure 'Nº do Próximo Jogo' =
			VAR _agora = NOW () - 2 / 24
			VAR _k = MAX ( fact_fixtures[kickoff_brasilia] )
			RETURN
			    IF (
			        HASONEVALUE ( fact_fixtures[kickoff_brasilia] ) && _k > _agora,
			        CALCULATE (
			            COUNTROWS ( fact_fixtures ),
			            REMOVEFILTERS ( fact_fixtures ),
			            fact_fixtures[kickoff_brasilia] > _agora,
			            fact_fixtures[kickoff_brasilia] <= _k
			        )
			    )
		formatString: 0
		displayFolder: 4. Tabela e Momento
		lineageTag: dbb8acf2-5c8f-56cc-a8fa-19180b9db914

	/// Métrica própria de 1 (fácil) a 5 (difícil) pela posição atual de cada adversário na tabela.
	measure 'Dificuldade Próximos 5' =
			VAR _agora = NOW () - 2 / 24
			VAR _prox =
			    TOPN (
			        5,
			        FILTER ( fact_fixtures, fact_fixtures[kickoff_brasilia] > _agora ),
			        fact_fixtures[kickoff_brasilia], ASC
			    )
			RETURN
			    AVERAGEX ( _prox, fact_fixtures[difficulty] )
		formatString: 0.0
		displayFolder: 4. Tabela e Momento
		lineageTag: 16d98c25-5ab9-5f43-bc3c-3fa18a97a417

	measure 'Jogos Restantes' = CALCULATE ( COUNTROWS ( fact_fixtures ), fact_fixtures[finished] = FALSE () )
		formatString: 0
		displayFolder: 4. Tabela e Momento
		lineageTag: 2159a120-307d-59cd-b506-9f96659acd0c

	/// Jogos já disputados cujo placar ainda não chegou às fontes. Mostre como aviso quando > 0.
	measure 'Resultados Pendentes' = CALCULATE ( COUNTROWS ( fact_fixtures ), fact_fixtures[result_pending] = TRUE () )
